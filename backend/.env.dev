APP_ENV=dev
USE_MOCK_DATA=false
USE_CACHE=true
ENABLE_OPENALEX=true
ENABLE_DBLP=true
ENABLE_CROSSREF=true
ENABLE_ARXIV=true
ENABLE_SCHOLAR=true
ENABLE_FACULTY=false
LOG_LEVEL=debug
DATABASE_URL=sqlite+aiosqlite:///./academic_search.db
OPENALEX_MAILTO=academic-search@demo.com
CROSSREF_MAILTO=academic-search@demo.com
SOURCE_TIMEOUT=10
CACHE_TTL_HOURS=24
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MINUTES=15
