APP_ENV=dev
USE_MOCK_DATA=true
USE_CACHE=true
ENABLE_OPENALEX=true
ENABLE_DBLP=true
ENABLE_CROSSREF=true
ENABLE_ARXIV=true
ENABLE_SCHOLAR=false
ENABLE_FACULTY=false
LOG_LEVEL=info
DATABASE_URL=sqlite+aiosqlite:///./academic_search.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENALEX_MAILTO=your-email@example.com
CROSSREF_MAILTO=your-email@example.com
SOURCE_TIMEOUT=10
CACHE_TTL_HOURS=24
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MINUTES=15
VECTOR_INDEX_PATH=./vector_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TIMEOUT_SECONDS=15
# Optional native Gemini generateContent provider.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
# Put the real key only in ignored backend/.env or the process environment.
# Never put this key in frontend/Vite variables or source control.
GEMINI_API_KEY=replace-with-your-gemini-api-key

OPENALEX_API_KEY=your-openalex-api-key
